[Unit]
Description=Health Thermometer Profile BLE logging daemon
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=health-thermometer-daemon
Group=health-thermometer-daemon
SupplementaryGroups=bluetooth
ExecStart=/usr/bin/health-thermometer-daemon --config /etc/health-thermometer-daemon/config.ini
Restart=on-failure
RestartSec=5
StateDirectory=health-thermometer-daemon
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
